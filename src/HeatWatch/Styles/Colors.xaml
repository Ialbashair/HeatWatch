<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window background -->
    <Color x:Key="WindowBgColor">#FF1A1A1A</Color>
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush"  Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#252525"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#2E2E2E"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"        Color="#353535"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"  Color="#2A2A2A"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#EFEFEF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#909090"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#555555"/>

    <!-- Accent -->
    <Color x:Key="AccentColor">#0078D4</Color>
    <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1388DE"/>

    <!-- Title bar -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#111111"/>

    <!-- Settings sidebar -->
    <SolidColorBrush x:Key="SidebarBrush"            Color="#111111"/>
    <SolidColorBrush x:Key="NavItemHoverBrush"        Color="#2C2C2C"/>
    <SolidColorBrush x:Key="NavItemSelectedBrush"     Color="#323232"/>
    <SolidColorBrush x:Key="ControlPressedBrush"      Color="#383838"/>

    <!-- Heat accent colors (solid, used as left-strip on node cards) -->
    <SolidColorBrush x:Key="HeatCoolBrush"   Color="#3DC45A"/>
    <SolidColorBrush x:Key="HeatWarmBrush"   Color="#D4A017"/>
    <SolidColorBrush x:Key="HeatHotBrush"    Color="#D46717"/>
    <SolidColorBrush x:Key="HeatCritBrush"   Color="#D43017"/>
    <SolidColorBrush x:Key="HeatNeutralBrush" Color="#404040"/>

</ResourceDictionary>
