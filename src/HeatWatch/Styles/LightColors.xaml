<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window background -->
    <Color x:Key="WindowBgColor">#FFF3F3F3</Color>
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush"  Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#E4E4E4"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"        Color="#D0D0D0"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"  Color="#E0E0E0"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#AAAAAA"/>

    <!-- Accent -->
    <Color x:Key="AccentColor">#0078D4</Color>
    <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1388DE"/>

    <!-- Title bar -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#E8E8E8"/>

    <!-- Settings sidebar -->
    <SolidColorBrush x:Key="SidebarBrush"            Color="#E0E0E0"/>
    <SolidColorBrush x:Key="NavItemHoverBrush"        Color="#D4D4D4"/>
    <SolidColorBrush x:Key="NavItemSelectedBrush"     Color="#C8C8C8"/>
    <SolidColorBrush x:Key="ControlPressedBrush"      Color="#BBBBBB"/>

    <!-- Heat accent colors (same across themes) -->
    <SolidColorBrush x:Key="HeatCoolBrush"    Color="#3DC45A"/>
    <SolidColorBrush x:Key="HeatWarmBrush"    Color="#D4A017"/>
    <SolidColorBrush x:Key="HeatHotBrush"     Color="#D46717"/>
    <SolidColorBrush x:Key="HeatCritBrush"    Color="#D43017"/>
    <SolidColorBrush x:Key="HeatNeutralBrush" Color="#909090"/>

</ResourceDictionary>
