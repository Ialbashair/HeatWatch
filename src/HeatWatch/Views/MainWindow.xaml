<Window x:Class="HeatWatch.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HeatWatch.ViewModels"
        xmlns:controls="clr-namespace:HeatWatch.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HeatWatch"
        Width="300"
        Height="210"
        MinWidth="{Binding WindowMinWidth}"
        MinHeight="{Binding WindowMinHeight}"
        SizeToContent="{Binding SizeToContent}"
        WindowStyle="None"
        Background="{DynamicResource WindowBgBrush}"
        ResizeMode="{Binding ResizeMode}"
        Topmost="{Binding IsTopmost}"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

<Window.Resources>
        <DataTemplate DataType="{x:Type vm:NodeViewModel}">
            <controls:SensorNodeControl DataContext="{Binding}"/>
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{DynamicResource WindowBgBrush}">
        <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Height="36"
                    Background="{DynamicResource TitleBarBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Visibility="{Binding ShowTitleBar, Converter={StaticResource BoolToVis}}">
                <Grid Margin="12,0,6,0">
                    <!-- App name + icon -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9CA;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="HeatWatch"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Always on top toggle -->
                        <ToggleButton Style="{StaticResource ToggleButtonStyle}"
                                      IsChecked="{Binding IsTopmost}"
                                      ToolTip="Always on Top"
                                      Content="&#xE840;"/>
                        <!-- Settings -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="Settings"
                                Content="&#xE713;"/>
                        <!-- Close -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="Close_Click"
                                ToolTip="Exit"
                                Content="&#xE711;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Separator -->
            <Rectangle Grid.Row="0"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{DynamicResource BorderBrush}"
                       Visibility="{Binding ShowTitleBar, Converter={StaticResource BoolToVis}}"/>

            <!-- Sensor node list -->
            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource DarkScrollViewerStyle}"
                          MaxHeight="580"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,7,8,8">
                    <!-- Stacked view (virtualized) -->
                    <ItemsControl ItemsSource="{Binding Nodes}" Focusable="False"
                                  Visibility="{Binding IsStackedView, Converter={StaticResource BoolToVis}}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Grid view (3 columns) -->
                    <ItemsControl ItemsSource="{Binding Nodes}" Focusable="False"
                                  Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="70"
                                        Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,0,4,4"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="3"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card content -->
                                        <StackPanel Grid.Row="0"
                                                    Margin="8,7,8,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Value}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Bottom"/>
                                                <TextBlock Text="{Binding Unit}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="10"
                                                           VerticalAlignment="Bottom"
                                                           Margin="3,0,0,1"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Bottom heat strip -->
                                        <Rectangle Grid.Row="1" Fill="{Binding HeatColor}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- CPU driver warning — shown when security software has blocked hardware sensor access -->
                    <Border Padding="10,8"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource HeatWarmBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,2,0,4"
                            Visibility="{Binding ShowCpuDriverWarning, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource HeatWarmBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="CPU temps unavailable"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap">
                                <Run Text="Windows Defender blocked a driver HeatWatch needs to read CPU temperatures. Open"/>
                                <Run Text="Windows Security → Virus &amp; threat protection → Protection history"
                                     Foreground="{DynamicResource AccentBrush}"/>
                                <Run Text="and allow the blocked item."/>
                            </TextBlock>
                            <Button Content="Learn more"
                                    Style="{StaticResource HyperlinkButtonStyle}"
                                    Command="{Binding OpenDriverWarningCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,5,0,0" Click="Button_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- First-run hint — shown until the user opens Settings -->
                    <Border Padding="10,8"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,2,0,4"
                            Visibility="{Binding ShowSettingsHint, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap">
                                <Run Text="Add more sensors from the"/>
                                <Run Text="Settings" Foreground="{DynamicResource AccentBrush}" FontWeight="Medium"/>
                                <Run Text="menu."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Empty state — shown when no sensors are enabled -->
                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,20,0,24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Nodes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE9CA;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="No sensors enabled"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Open Settings to choose sensors"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Tray notification overlay -->
            <Border Grid.Row="1"
                    VerticalAlignment="Bottom"
                    Margin="8,0,8,8"
                    Padding="10,8"
                    Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding ShowTrayMessage, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE7C4;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"/>
                            <TextBlock Text="HeatWatch lives in the tray"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,8,0">
                            <Run Text="Double-click the tray icon to show or hide the window. Right-click to exit. Change this in"/>
                            <Run Text="Settings &#x2192; Behaviour" Foreground="{DynamicResource AccentBrush}" FontWeight="Medium"/><Run Text="."/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            Content="&#xE711;"
                            FontSize="10"
                            VerticalAlignment="Top"
                            Command="{Binding DismissTrayMessageCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
