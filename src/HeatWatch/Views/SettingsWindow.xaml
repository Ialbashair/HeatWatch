<Window x:Class="HeatWatch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HeatWatch.ViewModels"
        xmlns:models="clr-namespace:HeatWatch.Core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HeatWatch — Settings"
        Width="640"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ Title bar ═══ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,6,0">
                    <TextBlock Text="Settings"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="&#xE711;"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BorderBrush}"/>

            <!-- ═══ Body: sidebar + content ═══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left nav sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Main nav -->
                        <StackPanel Grid.Row="0" Margin="0,10,0,0">
                            <TextBlock Text="HEATWATCH"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="16,0,0,8"/>

                            <ListBox Style="{StaticResource NavListStyle}"
                                     SelectedIndex="{Binding SelectedTabIndex}"
                                     ItemContainerStyle="{StaticResource NavItemStyle}">

                                <!-- Sensors -->
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9CA;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Sensors"
                                                   FontSize="12"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>

                                <!-- Appearance -->
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE790;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Appearance"
                                                   FontSize="12"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>

                                <!-- Behaviour -->
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7FC;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Behaviour"
                                                   FontSize="12"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>

                            </ListBox>
                        </StackPanel>

                        <!-- Row 1: Learn More — only visible when driver is blocked -->
                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding ShowDriverWarningTab, Converter={StaticResource BoolToVis}}">
                            <Rectangle Height="1"
                                       Fill="{DynamicResource BorderBrush}"
                                       Margin="12,8,12,4"/>
                            <Button Command="{Binding SelectLearnMoreTabCommand}"
                                    Margin="6,1"
                                    FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="10,9"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource HeatWarmBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Lbl"
                                                           Text="Learn More"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource NavItemHoverBrush}"/>
                                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsLearnMoreSelected}" Value="True">
                                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource NavItemSelectedBrush}"/>
                                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Row 2: Version -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding AppVersion}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Left"
                                   Margin="16,6,0,12"/>
                    </Grid>
                </Border>

                <!-- Right content area -->
                <Grid Grid.Column="1">

                    <!-- ── Sensors tab ── -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Page title -->
                        <TextBlock Grid.Row="0"
                                   Text="Sensors"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="16,14,16,10"/>

                        <!-- Search box + column headers -->
                        <StackPanel Grid.Row="1" Margin="16,0,16,6">
                            <Border Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE721;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="9,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             FontSize="12"
                                             Padding="0,7"
                                             VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Resources>
                                                    <VisualBrush x:Key="PlaceholderBrush" TileMode="None" Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Search sensors..."
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontSize="12"
                                                                       Margin="0,7"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Style.Resources>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="SENSOR" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="ORDER"  Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Node list -->
                        <ScrollViewer Grid.Row="2"
                                      Style="{StaticResource DarkScrollViewerStyle}"
                                      Margin="16,0,16,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredNodes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:NodeDefinition}">
                                        <Border Background="{DynamicResource Surface2Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,4"
                                                Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Style="{StaticResource DarkCheckBoxStyle}"
                                                          IsChecked="{Binding IsEnabled}"
                                                          Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             FontSize="12"
                                                             Padding="0"
                                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                             SelectionBrush="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding HardwareName}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="10"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                            Content="&#xE70E;" FontSize="11" Padding="5,4"
                                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                            Content="&#xE70D;" FontSize="11" Padding="5,4"
                                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ── Appearance tab ── -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer Style="{StaticResource DarkScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="Appearance"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <!-- THEME — three options in a single row -->
                            <TextBlock Text="THEME"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <UniformGrid Columns="3" Margin="0,0,0,0">
                                <RadioButton Content="Dark"
                                             Style="{StaticResource ThemeOptionStyle}"
                                             GroupName="AppTheme"
                                             IsChecked="{Binding IsThemeDark}"
                                             Margin="0,0,6,0"/>
                                <RadioButton Content="Light"
                                             Style="{StaticResource ThemeOptionStyle}"
                                             GroupName="AppTheme"
                                             IsChecked="{Binding IsThemeLight}"
                                             Margin="0,0,6,0"/>
                                <RadioButton Content="System Default"
                                             Style="{StaticResource ThemeOptionStyle}"
                                             GroupName="AppTheme"
                                             IsChecked="{Binding IsThemeSystem}"
                                             Margin="0"/>
                            </UniformGrid>

                            <!-- VIEW — two cards side by side with visual previews -->
                            <TextBlock Text="VIEW"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,20,0,10"/>

                            <UniformGrid Columns="2">

                                <!-- Stacked view card -->
                                <RadioButton Style="{StaticResource ViewOptionStyle}"
                                             GroupName="AppView"
                                             IsChecked="{Binding IsViewStacked}"
                                             Tag="Stacked"
                                             Margin="0,0,6,0">
                                    <!-- Preview: 3 horizontal rows with left accent strip -->
                                    <StackPanel>
                                        <Border Height="9" CornerRadius="2" Margin="0,0,0,3"
                                                Background="{DynamicResource Surface3Brush}"
                                                ClipToBounds="True">
                                            <Rectangle Width="3" HorizontalAlignment="Left"
                                                       Fill="{DynamicResource HeatCoolBrush}"/>
                                        </Border>
                                        <Border Height="9" CornerRadius="2" Margin="0,0,0,3"
                                                Background="{DynamicResource Surface3Brush}"
                                                ClipToBounds="True">
                                            <Rectangle Width="3" HorizontalAlignment="Left"
                                                       Fill="{DynamicResource HeatWarmBrush}"/>
                                        </Border>
                                        <Border Height="9" CornerRadius="2"
                                                Background="{DynamicResource Surface3Brush}"
                                                ClipToBounds="True">
                                            <Rectangle Width="3" HorizontalAlignment="Left"
                                                       Fill="{DynamicResource HeatHotBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Grid view card -->
                                <RadioButton Style="{StaticResource ViewOptionStyle}"
                                             GroupName="AppView"
                                             IsChecked="{Binding IsViewGrid}"
                                             Tag="Grid"
                                             Margin="0">
                                    <!-- Preview: 2 rows × 3 cols mini cards with bottom heat strip -->
                                    <UniformGrid Columns="3">
                                        <Border Margin="0,0,3,3" CornerRadius="2" Height="18"
                                                Background="{DynamicResource Surface3Brush}"
                                                ClipToBounds="True">
                                            <Rectangle Height="2" VerticalAlignment="Bottom"
                                                       Fill="{DynamicResource HeatCoolBrush}"/>
                                        </Border>
                                        <Border Margin="0,0,3,3" CornerRadius="2" Height="18"
                                                Background="{DynamicResource Surface3Brush}"
                                                ClipToBounds="True">
                                            <Rectangle Height="2" VerticalAlignment="Bottom"
                                                       Fill="{DynamicResource HeatWarmBrush}"/>
                                        </Border>
                                        <Border Margin="0,0,0,3" CornerRadius="2" Height="18"
                                                Background="{DynamicResource Surface3Brush}"
                                                ClipToBounds="True">
                                            <Rectangle Height="2" VerticalAlignment="Bottom"
                                                       Fill="{DynamicResource HeatHotBrush}"/>
                                        </Border>
                                        <Border Margin="0,0,3,0" CornerRadius="2" Height="18"
                                                Background="{DynamicResource Surface3Brush}"
                                                ClipToBounds="True">
                                            <Rectangle Height="2" VerticalAlignment="Bottom"
                                                       Fill="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <Border Margin="0,0,3,0" CornerRadius="2" Height="18"
                                                Background="{DynamicResource Surface3Brush}"
                                                ClipToBounds="True">
                                            <Rectangle Height="2" VerticalAlignment="Bottom"
                                                       Fill="{DynamicResource HeatCritBrush}"/>
                                        </Border>
                                        <Border Margin="0,0,0,0" CornerRadius="2" Height="18"
                                                Background="{DynamicResource Surface3Brush}"
                                                ClipToBounds="True">
                                            <Rectangle Height="2" VerticalAlignment="Bottom"
                                                       Fill="{DynamicResource HeatNeutralBrush}"/>
                                        </Border>
                                    </UniformGrid>
                                </RadioButton>

                            </UniformGrid>


                            <!-- DISPLAY -->
                            <TextBlock Text="DISPLAY"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,20,0,10"/>

                            <!-- Focus Mode -->
                            <Border Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,6">
                                <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                          IsChecked="{Binding AutoHideControls}">
                                    <StackPanel Margin="2,0,0,0">
                                        <TextBlock Text="Focus Mode"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="Hide the title bar after 3 seconds when the cursor leaves the window."
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Heat Indicators -->
                            <Border Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,0">
                                <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                          IsChecked="{Binding UseHeatColors}">
                                    <StackPanel Margin="2,0,0,0">
                                        <TextBlock Text="Heat Indicators"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="Colour-code sensor accents green, amber, and red based on temperature level."
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ── Behaviour tab ── -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel Margin="16,14,16,0">
                            <TextBlock Text="Behaviour"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="GENERAL"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <!-- Start with Windows -->
                            <Border Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,6">
                                <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                          IsChecked="{Binding IsRunAtStartup}">
                                    <StackPanel Margin="2,0,0,0">
                                        <TextBlock Text="Start with Windows"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="Launch HeatWatch automatically when you sign in."
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Minimize to tray -->
                            <Border Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,6">
                                <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                          IsChecked="{Binding MinimizeToTray}">
                                    <StackPanel Margin="2,0,0,0">
                                        <TextBlock Text="Minimize to tray on close"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="Keep HeatWatch running in the system tray when you close the window. Right-click the tray icon to exit."
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Allow window resizing -->
                            <Border Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,6">
                                <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                          IsChecked="{Binding IsResizable}">
                                    <StackPanel Margin="2,0,0,0">
                                        <TextBlock Text="Allow window resizing"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="Show a resize grip so you can adjust the window dimensions."
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ── Learn More tab (index 3) — driver blocked ── -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer Style="{StaticResource DarkScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,14,16,16">

                                <!-- Title row with warning icon -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="20"
                                               Foreground="{DynamicResource HeatWarmBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="CPU Temperatures Blocked"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,20">
                                    HeatWatch uses a small kernel driver to read CPU temperatures directly from hardware registers. Windows Defender has blocked or removed that driver, which is why CPU temperature sensors are not appearing. GPU and other sensors are unaffected.
                                </TextBlock>

                                <!-- Why this happens -->
                                <TextBlock Text="WHY THIS HAPPENS"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,20">
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               LineHeight="20">
                                        HeatWatch relies on <Run Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium">WinRing0x64.sys</Run>, an open-source kernel driver used by many hardware monitoring tools. Because the driver accesses hardware at a low level, Windows Defender's behavioural protection can flag it as a potentially unwanted application.
                                    </TextBlock>
                                </Border>

                                <!-- How to fix it -->
                                <TextBlock Text="HOW TO FIX IT"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <!-- Step 1 -->
                                <Border Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="1"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Top"
                                                   Margin="0,1,0,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap">
                                            Press <Run Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium">Start</Run> and search for <Run Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium">Windows Security</Run>, then open it.
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Step 2 -->
                                <Border Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="2"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Top"
                                                   Margin="0,1,0,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap">
                                            Go to <Run Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium">Virus &amp; threat protection</Run>.
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Step 3 -->
                                <Border Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="3"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Top"
                                                   Margin="0,1,0,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap">
                                            Under "Current threats", click <Run Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium">Protection history</Run>.
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Step 4 -->
                                <Border Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="4"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Top"
                                                   Margin="0,1,0,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap">
                                            Find the entry labelled <Run Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium">WinRing0x64</Run> or <Run Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium">HeatWatch</Run>. It may be listed as "Severe" or "Potentially unwanted app".
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Step 5 -->
                                <Border Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="5"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Top"
                                                   Margin="0,1,0,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap">
                                            Click the entry to expand it, then choose <Run Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium">Actions → Allow on device</Run>.
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Step 6 -->
                                <Border Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="6"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Top"
                                                   Margin="0,1,0,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap">
                                            <Run Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium">Restart HeatWatch.</Run> CPU temperatures should now appear.
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Fallback note -->
                                <Border Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource HeatWarmBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10">
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap">
                                        <Run Text="&#xE946;"
                                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                             Foreground="{DynamicResource HeatWarmBrush}"/>
                                        <Run Text=" If the entry is not in Protection history, Defender may have already deleted the file. Re-installing HeatWatch will restore the driver."/>
                                    </TextBlock>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ═══ Footer ═══ -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10">
                <Grid>
                    <!-- Select All / Deselect All — only on Sensors tab -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="Select All"
                                Style="{StaticResource DialogCancelButtonStyle}"
                                Padding="12,7"
                                Margin="0,0,6,0"
                                Command="{Binding SelectAllCommand}"/>
                        <Button Content="Deselect All"
                                Style="{StaticResource DialogCancelButtonStyle}"
                                Padding="12,7"
                                Command="{Binding DeselectAllCommand}"/>
                    </StackPanel>

                    <!-- Cancel / Apply -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource DialogCancelButtonStyle}"
                                Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button Content="Apply"
                                Style="{StaticResource DialogApplyButtonStyle}"
                                Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
