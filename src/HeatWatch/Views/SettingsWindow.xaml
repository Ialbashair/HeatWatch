<Window x:Class="HeatWatch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HeatWatch.ViewModels"
        xmlns:models="clr-namespace:HeatWatch.Core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HeatWatch — Settings"
        Width="600"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ Title bar ═══ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,6,0">
                    <TextBlock Text="Settings"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="&#xE711;"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BorderBrush}"/>

            <!-- ═══ Body: sidebar + content ═══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left nav sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <StackPanel Margin="0,10,0,0">

                        <!-- Section label -->
                        <TextBlock Text="HEATWATCH"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="16,0,0,8"/>

                        <ListBox Style="{StaticResource NavListStyle}"
                                 SelectedIndex="{Binding SelectedTabIndex}"
                                 ItemContainerStyle="{StaticResource NavItemStyle}">

                            <!-- Sensors -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9CA;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Sensors"
                                               FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Appearance -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Appearance"
                                               FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Startup -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Startup"
                                               FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                        </ListBox>
                        </StackPanel>

                        <!-- Version pinned to bottom -->
                        <TextBlock Text="{Binding AppVersion}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Left"
                                   Margin="16,0,0,12"/>
                    </Grid>
                </Border>

                <!-- Right content area -->
                <Grid Grid.Column="1">

                    <!-- ── Sensors tab ── -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Page title -->
                        <TextBlock Grid.Row="0"
                                   Text="Sensors"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="16,14,16,10"/>

                        <!-- Search box + column headers -->
                        <StackPanel Grid.Row="1" Margin="16,0,16,6">
                            <Border Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE721;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="9,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             FontSize="12"
                                             Padding="0,7"
                                             VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Resources>
                                                    <VisualBrush x:Key="PlaceholderBrush" TileMode="None" Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Search sensors..."
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontSize="12"
                                                                       Margin="0,7"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Style.Resources>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="SENSOR" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="ORDER"  Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Node list -->
                        <ScrollViewer Grid.Row="2"
                                      Style="{StaticResource DarkScrollViewerStyle}"
                                      Margin="16,0,16,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredNodes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:NodeDefinition}">
                                        <Border Background="{DynamicResource Surface2Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,4"
                                                Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Style="{StaticResource DarkCheckBoxStyle}"
                                                          IsChecked="{Binding IsEnabled}"
                                                          Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             FontSize="12"
                                                             Padding="0"
                                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                             SelectionBrush="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding HardwareName}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="10"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                            Content="&#xE70E;" FontSize="11" Padding="5,4"
                                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                            Content="&#xE70D;" FontSize="11" Padding="5,4"
                                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ── Appearance tab ── -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel Margin="16,14,16,0">
                            <TextBlock Text="Appearance"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="THEME"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <RadioButton Content="Dark"
                                         Style="{StaticResource ThemeOptionStyle}"
                                         GroupName="AppTheme"
                                         IsChecked="{Binding IsThemeDark}"/>

                            <RadioButton Content="Light"
                                         Style="{StaticResource ThemeOptionStyle}"
                                         GroupName="AppTheme"
                                         IsChecked="{Binding IsThemeLight}"/>

                            <RadioButton Content="System Default"
                                         Style="{StaticResource ThemeOptionStyle}"
                                         GroupName="AppTheme"
                                         IsChecked="{Binding IsThemeSystem}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── Startup tab ── -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel>
                            <TextBlock Text="Startup"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="16,14,16,4"/>
                            <TextBlock Text="Startup behavior options coming soon."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="16,6,16,0"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ═══ Footer ═══ -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10">
                <Grid>
                    <!-- Select All / Deselect All — only on Sensors tab -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="Select All"
                                Style="{StaticResource DialogCancelButtonStyle}"
                                Padding="12,7"
                                Margin="0,0,6,0"
                                Command="{Binding SelectAllCommand}"/>
                        <Button Content="Deselect All"
                                Style="{StaticResource DialogCancelButtonStyle}"
                                Padding="12,7"
                                Command="{Binding DeselectAllCommand}"/>
                    </StackPanel>

                    <!-- Cancel / Apply -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource DialogCancelButtonStyle}"
                                Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button Content="Apply"
                                Style="{StaticResource DialogApplyButtonStyle}"
                                Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
